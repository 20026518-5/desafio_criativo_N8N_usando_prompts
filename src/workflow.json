    {
      "parameters": {
        "jsCode": "// Filtra as notícias publicadas nas últimas 24 horas e limita a 5 itens\nconst agora = new Date();\nconst limiteHoras = 24 * 60 * 60 * 1000;\n\nconst noticiasFiltradas = items.filter(item => {\n  const dataPub = new Date(item.json.pubDate || item.json.isoDate);\n  return (agora - dataPub) <= limiteHoras;\n});\n\nreturn noticiasFiltradas.slice(0, 5);"
      },
      "id": "9218ab2a-9e22-4a0d-8302-3c829d10e111",
      "name": "Filtrar Últimas 24h (Max 5)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        500
      ]
    },
    {
